/target
/.build/

# Pinned reading copies, not source: `scripts/fetch-upstream.sh` re-derives
# `upstream/<name>/` from `upstream/pins.toml` alone, so committing a checkout
# would pin the tree to whoever fetched last. Only the pins are reviewed.
upstream/*
!upstream/pins.toml

# Per-worktree Cargo config, generated by `scripts/new-worktree.sh` with
# machine-local absolute paths. Never reviewed, never committed.
/.cargo/

# Runtime state, not source: the log of which slices have been handed out on
# this machine. One contributor's history is not the project's, and committing it
# would make every other contributor's suppression window wrong.
.ferrox/

# A lane's account and pass, written by `foxy-connect.sh` under $FOXY_CONF_DIR
# default ~/.ferrox. A copy checked into the tree would be a checked-in secret,
# so the script refuses to read one that is tracked and never writes it here.
/foxy-credentials
/credentials
/.freebuff
.DS_Store

# Bytecode from syntax-checking the benchmark scripts: `python3 -m py_compile`
# writes it beside the source, and it is never an artefact.
__pycache__/
*.pyc
/.obsidian
/.claude

# Worktrees created under the repository, so a clone never records one as a
# nested repository. `/ferrox-opencode-*` siblings are outside and need nothing.
/.worktrees
/.workbuddy-ai

# The macOS bundle and the lane configs it writes: build output and account
# material, never reviewed, never committed. The CLI and its two pages are the
# exception the release job packages, so they are tracked.
/dist/*
!/dist/ferrox-cli.sh
!/dist/README.md
!/dist/USAGE.md
/lane.json
/pass.json
